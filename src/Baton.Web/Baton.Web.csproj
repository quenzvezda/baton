<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <Description>Blazor Server UI: automation editor, workflow catalog, runs, hosts, queue dashboard. Talks to the Control Plane API only.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Baton.Web.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- OIDC authorization-code sign-in with a cookie session (ADR-0012, ADR-0014) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
  </ItemGroup>
  <ItemGroup>
    <!-- OpenTelemetry baseline, shared as source (M7 task 1.5) -->
    <Compile Include="../Shared/BatonTelemetry.cs" Link="Shared/BatonTelemetry.cs" />
    <Compile Include="../Shared/BatonAspNetCoreTelemetry.cs" Link="Shared/BatonAspNetCoreTelemetry.cs" />
  </ItemGroup>
</Project>
